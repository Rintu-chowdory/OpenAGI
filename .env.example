# ---- OpenAGI Personal Edition ----
# LLM backend for standalone execution (used when the aios kernel is absent).
# Works with any OpenAI-compatible endpoint: Groq, OpenAI, Together, OpenRouter, vLLM...

# Groq example (default if only GROQ_API_KEY is set):
OPENAGI_LLM_BASE_URL=https://api.groq.com/openai/v1
OPENAGI_LLM_MODEL=openai/gpt-oss-120b
OPENAGI_LLM_API_KEY=''

# ---- Execution mode ----
# auto (default): use the aios kernel if installed, otherwise standalone
# standalone:      always call the LLM API directly
# aios:           require the aios kernel
#OPENAGI_EXECUTION_MODE=auto

# ---- Agent hub (optional) ----
#OPENAGI_AGENT_HUB_URL=https://openagi-beta.vercel.app
#OPENAGI_CACHE_DIR=

# ---- External tools (optional) ----
RAPID_API_KEY=''
WOLFRAM_ALPHA_APPID=''
